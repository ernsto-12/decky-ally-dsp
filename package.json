{
  "name": "ally-dsp",
  "version": "0.2.1",
  "description": "Ally DSP fork with experimental original Dolby DLL processing for SteamOS",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "node scripts/gen-version.mjs && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernsto-12/decky-ally-dsp.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "rog-ally",
    "rog-ally-x",
    "xbox-ally",
    "audio",
    "dsp",
    "dolby"
  ],
  "author": "bassobr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ernsto-12/decky-ally-dsp/issues"
  },
  "homepage": "https://github.com/ernsto-12/decky-ally-dsp#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.63.4",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
